+
+    world.player.weapon = 'toothbrush';
+    expect(pub.frame().weapon).toBe('toothbrush');
+    expect(pub.publicaciones).toBe(1);
+  });
+
+  it('la vida del jefe la escribe la IA y sobrevive al sincronizado', () => {
