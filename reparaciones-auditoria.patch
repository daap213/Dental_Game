+    world.hud.bossName = 'Tartar Tank';
+    world.hud.bossMaxHp = 3500;
+    world.hud.bossHp = 3500;
+    const snap = pub.frame();
+
+    expect(snap).toMatchObject({ bossName: 'Tartar Tank', bossHp: 3500, bossMaxHp: 3500 });
+  });
+});
